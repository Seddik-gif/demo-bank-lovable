# Copy this file to .env.local and fill in your own key. Never commit .env.local.
#
# Optional. A free Finnhub key gives live US stock quotes on the Invest page.
# Sign up at https://finnhub.io/register and copy the key from the dashboard.
# Without a key, stock prices use a simulated feed and the page says so.
VITE_FINNHUB_API_KEY=
